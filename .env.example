# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# === Supabase (Noël pour Tous à Batcha) ===
# Template à copier dans `.env` avec les vraies valeurs du projet Supabase
# (Settings → API dans le dashboard). Le fichier `.env` est exclu par .gitignore.

# URL du projet (Project URL / API URL)
VITE_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Clé anon/publishable (public, sûre pour le bundle frontend Vite)
VITE_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Clé service_role (SECRET, augmentée) : NE PAS préfixer par VITE_ et NE JAMAIS
# mettre dans le frontend. Elle ne sert qu'aux scripts serveur (npm run
# create:manager) qui créent des comptes Auth côté administrateur.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Supabase: URL du projet et clé publique "anon" (publishable).
# Copier ce fichier en .env et renseigner les vraies valeurs. Le .env ne doit
# jamais être committé (déjà exclu par .gitignore).
VITE_SUPABASE_URL="https://pnowjltyxbdlmafcrwnu.supabase.co"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
